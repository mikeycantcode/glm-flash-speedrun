index 3857dff..3a2f593 100644
--- a/candidate/image.py
+++ b/candidate/image.py
@@ -14,4 +14,11 @@ def build_image() -> modal.Image:
         modal.Image.from_registry(SGLANG_IMAGE)
         .entrypoint([])
         .run_commands("python3 -m pip install --no-cache-dir 'transformers==5.20.1'")
+        # resolve_greedy_mask returns top_ks unsliced; the DFLASH worker copies it into a
+        # [:bs] buffer and crashes ("shape [1] doesn't match the broadcast shape [2]").
+        .run_commands(
+            "f=$(python3 -c 'import sglang.srt.speculative.dspark_components.dspark_draft as m; print(m.__file__)')"
+            " && sed -i 's/return (sampling_info.top_ks <= 1).view(-1)$/return (sampling_info.top_ks <= 1).view(-1)[:bs]/' $f"
+            " && grep -q 'view(-1)\\[:bs\\]' $f"
+        )
     )
